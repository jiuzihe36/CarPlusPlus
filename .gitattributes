# Normalise line endings so a clone on any platform matches what CI sees.
# Without this, core.autocrlf on Windows silently decides, and shell scripts end up with
# CRLF on checkout ("bad interpreter: /bin/sh^M") on the Linux runner.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.jks binary
*.keystore binary
*.so binary
*.zip binary
*.apk binary
*.dex binary

# Generated by scripts/build_site.py from site/content.json. Kept in git so the site can be
# previewed without running the generator, but excluded from diffs to reduce review noise.
site/**/index.html linguist-generated=true
