<?xml version="1.0" encoding="utf-8"?>
<!--
  Car++ 待机首页 · 竖屏

  按 ICCOA CarLink 车机端 2.0.4 的实际界面做：一块屏幕就四样东西 ——
  连接码、状态、进度、入口按钮。没有说明段落，没有法务长文（法务文案保留在
  「关于」页，不在首页占屏）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/da_gradient_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 顶栏：品牌 + 回车机主屏 -->
        <!-- 品牌区：长按「Car++」弹出设置（见 HomeFragment）。 -->
        <LinearLayout
            android:id="@+id/brand_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/da_brand"
                android:textColor="@color/da_text"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exit_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/da_close"
                android:textColor="@color/da_muted" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="36dp" />

        <!-- 连接进度 -->
        <com.carpp.sdk.view.RingProgressView
            android:id="@+id/ring_progress"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:importantForAccessibility="no" />

        <!-- 状态 -->
        <TextView
            android:id="@+id/connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/da_ready"
            android:textColor="@color/da_text"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:textColor="@color/da_muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- 6 位连接码：只在协议发了码才出现 -->
        <LinearLayout
            android:id="@+id/pairing_code_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.24"
                android:text="@string/da_pin_label"
                android:textColor="@color/da_accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pairing_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/da_text"
                android:textSize="56sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <!-- 刷新配对码（未连接时） / 打开投屏（已连接时） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh_pin_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/da_refresh_pin"
            android:textAllCaps="false"
            android:textColor="@color/da_accent"
            android:textSize="16sp"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wifi_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/da_open"
            android:textAllCaps="false"
            android:textColor="@color/da_background"
            android:textSize="16sp"
            android:visibility="gone"
            app:backgroundTint="@color/da_accent"
            app:cornerRadius="18dp" />
    </LinearLayout>
</ScrollView>
