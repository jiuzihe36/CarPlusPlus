<?xml version="1.0" encoding="utf-8"?>
<!--
  Car++ 待机首页 · 横屏

  与竖屏同一套四要素（连接码 / 状态 / 进度 / 入口），仅把进度环放到右侧：
  左侧看码，右侧看进度。没有说明段落、没有法务长文。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/da_gradient_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- 顶栏 -->
        <!-- 品牌区：长按「Car++」弹出设置（见 HomeFragment）。 -->
        <LinearLayout
            android:id="@+id/brand_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/da_brand"
                android:textColor="@color/da_text"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exit_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/da_close"
                android:textColor="@color/da_muted" />
        </LinearLayout>

        <!-- 主体：左码 / 右环 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- 左：状态 + 连接码 + 入口 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:text="@string/da_ready"
                    android:textColor="@color/da_text"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:textColor="@color/da_muted"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/pairing_code_block"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:letterSpacing="0.24"
                        android:text="@string/da_pin_label"
                        android:textColor="@color/da_accent"
                        android:textSize="15sp" />

                    <!-- 6 位必须一行放下：字号按最窄车机横屏左栏算，配 letterSpacing
                         也不能超过 400dp 的可用宽；折成两行要司机自己拼读就失去意义了。 -->
                    <TextView
                        android:id="@+id/pairing_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.06"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/da_text"
                        android:textSize="52sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refresh_pin_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="260dp"
                    android:layout_height="58dp"
                    android:layout_marginTop="30dp"
                    android:text="@string/da_refresh_pin"
                    android:textAllCaps="false"
                    android:textColor="@color/da_accent"
                    android:textSize="16sp"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wifi_button"
                    android:layout_width="260dp"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/da_open"
                    android:textAllCaps="false"
                    android:textColor="@color/da_background"
                    android:textSize="16sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/da_accent"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <!-- 右：连接进度环 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.carpp.sdk.view.RingProgressView
                    android:id="@+id/ring_progress"
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
