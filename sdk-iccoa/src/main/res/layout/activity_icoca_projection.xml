<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- The ICCOA SDK renders the phone's Miracast stream straight into this surface.
         UCarSurfaceView（SDK 自带）而不是裸 SurfaceView：它在 onTouchEvent 里把每一帧
         手指事件转成 UCarAdapter.sendTouchEvent，是 SDK 唯一支持的触摸回传入口。
         clickable 必须为 true —— 否则 View.onTouchEvent 返回 false，ViewGroup 只把
         ACTION_DOWN 投给它，后续 MOVE/UP 全部丢失（表现是点了没反应或一直按住）。 -->
    <com.ucar.vehiclesdk.UCarSurfaceView
        android:id="@+id/icoca_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true" />

    <TextView
        android:id="@+id/icoca_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/da_connecting"
        android:textColor="#CCFFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- Sits over the mirrored UI on purpose: a head unit may have no reachable Back, so there
         must always be a way out. Kept translucent so it stays out of the way. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/icoca_disconnect"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:alpha="0.45"
        android:text="@string/shortcut_disconnect_title"
        android:textColor="#FFFFFFFF" />

</FrameLayout>
