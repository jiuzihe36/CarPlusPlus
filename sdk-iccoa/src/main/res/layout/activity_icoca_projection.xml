<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- The ICCOA SDK renders the phone's Miracast stream straight into this surface.
         UCarSurfaceView（SDK 自带）而不是裸 SurfaceView：它在 onTouchEvent 里把每一帧
         手指事件转成 UCarAdapter.sendTouchEvent，是 SDK 唯一支持的触摸回传入口。
         clickable 必须为 true —— 否则 View.onTouchEvent 返回 false，ViewGroup 只把
         ACTION_DOWN 投给它，后续 MOVE/UP 全部丢失（表现是点了没反应或一直按住）。 -->
    <com.ucar.vehiclesdk.UCarSurfaceView
        android:id="@+id/icoca_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true" />

    <TextView
        android:id="@+id/icoca_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/da_connecting"
        android:textColor="#CCFFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- 退出投屏不靠这里的按钮：手机上那个「返回车机」按不动车机界面，只能发 GO_TO_HOME 事件
         请车机自己退 —— 由 IcocaProjectionActivity 收事件后退出视图（车机自带返回键同样处理）。
         所以本页不再自绘退出按钮，避免和手机侧那个重复。 -->
    <!-- 手机通知浮层：顶部横幅 + 点开后的通知列表。
         放在最上层，但自身不 clickable、没有通知时子 View 全是 GONE ——
         卡片以外的区域触摸照旧穿透到底下的 UCarSurfaceView，触摸回传不受影响。
         类在 :carpp-sdk 里（协议无关），只吃 PhoneNotifications 契约。 -->
    <com.carpp.sdk.view.NotificationOverlayView
        android:id="@+id/icoca_notifications"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
